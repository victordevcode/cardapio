const { MercadoPagoConfig, Payment } = require('mercadopago');

// Utilize o seu Access Token de produção ou teste do Mercado Pago
// Recomenda-se colocar no seu arquivo .env: MERCADOPAGO_ACCESS_TOKEN=seu_token
const client = new MercadoPagoConfig({
  accessToken: process.env.MERCADOPAGO_ACCESS_TOKEN || 'SEU_ACCESS_TOKEN_AQUI',
});

const payment = new Payment(client);

exports.gerarPagamentoPix = async (req, res) => {
  try {
    const { total, email, nome } = req.body;

    if (!total || !email) {
      return res.status(400).json({ success: false, message: 'Total e e-mail são obrigatórios.' });
    }

    const body = {
      transaction_amount: Number(total),
      description: 'Pedido - Cardápio Digital',
      payment_method_id: 'pix',
      payer: {
        email: email,
        first_name: nome || 'Cliente',
      },
    };

    const response = await payment.create({ body });

    // Extrai a chave Copia e Cola e o QR Code em imagem (base64)
    const transactionData = response.point_of_interaction.transaction_data;

    return res.status(200).json({
      success: true,
      pagamentoId: response.id,
      status: response.status,
      pixCopiaECola: transactionData.qr_code,
      qrCodeBase64: transactionData.qr_code_base64,
    });
  } catch (error) {
    console.error('Erro ao gerar pagamento PIX:', error);
    return res.status(500).json({
      success: false,
      message: 'Erro interno ao processar pagamento via PIX.',
      error: error.message,
    });
  }
};